diff --git a/examples/مثلثات.حع b/examples/مثلثات.حع
new file mode 100644
index 0000000..16fb544
--- /dev/null
+++ b/examples/مثلثات.حع
@@ -0,0 +1,26 @@
+# مثلثات.حع — الدوال المثلثية جا (جيب) وجتا (جيب التمام)
+# الزوايا تُقاس بالراديان، تمامًا مثل math.sin / numpy.sin.
+
+# قيم أساسية
+اطبع("جا(٠) =", جا(٠))            # ٠
+اطبع("جتا(٠) =", جتا(٠))          # ١
+
+# استخدام الثابت باي (π)
+اطبع("جا(باي ÷ ٢) =", جا(باي / ٢))   # ١ تقريبًا
+اطبع("جتا(باي) =", جتا(باي))         # −١ تقريبًا
+
+# المرادفان جيب وجيب_تمام يعملان بنفس الطريقة
+اطبع("جيب(١) =", جيب(١))
+اطبع("جيب_تمام(١) =", جيب_تمام(١))
+
+# المتطابقة المثلثية: جا²(س) + جتا²(س) = ١
+س = ٠.٧
+المجموع = جا(س) ^ ٢ + جتا(س) ^ ٢
+اطبع("جا² + جتا² =", المجموع)        # ١
+
+# دالة معرّفة تستخدم جا وجتا (ظا = جا/جتا)
+دالة ظا(ز) {
+    إرجع جا(ز) / جتا(ز)
+}
+
+اطبع("ظا(باي ÷ ٤) =", ظا(باي / ٤))      # ١ تقريبًا
