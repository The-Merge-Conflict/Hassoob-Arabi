+# مثلثات_رمزية.حع — جا وجتا مع الرياضيات الرمزية
+# تعمل جا/جتا على التعابير الرمزية وليس الأعداد فقط.
+
+رمز س
+
+# اشتقاق جا(س) يعطي جتا(س)
+المشتقة = اشتق(جا(س), س)
+اطبع("مشتقة جا(س):", المشتقة)        # cos(س)
+
+# اشتقاق جتا(س) يعطي −جا(س)
+اطبع("مشتقة جتا(س):", اشتق(جتا(س), س))   # -sin(س)
+
+# المتطابقة المثلثية تُبسّط إلى ١
+اطبع("تبسيط جا² + جتا²:", بسط(جا(س) ^ ٢ + جتا(س) ^ ٢))  # ١
+
+# التكامل غير المحدود لـ جا(س)
+اطبع("تكامل جا(س):", كامل(جا(س), س))         # -cos(س)
