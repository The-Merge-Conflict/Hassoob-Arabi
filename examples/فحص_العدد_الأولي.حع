# دالة تفحص إن كان العدد أوّليًا، وتُرجع صحيح/خطأ
دالة عدد_أولي(ن) {
	إذا (ن < ٢) {
		إرجع خطأ
	}
	د = ٢
	بينما (د * د <= ن) {
		إذا (ن % د == ٠) {
			إرجع خطأ
		}
		د += ١
	}
	إرجع صحيح
}

# امش على الأعداد من ٢ إلى ٤٠ بخطوة ١، وصنّفها:
#  - تخطَّ العدد ٩ تحديدًا (استمر)
#  - توقّف تمامًا بعد ٣٠ (اوقف)
لكل ن من ٢ إلى ٤٠ بخطوة ١ {
	إذا (ن == ٩) {
		استمر
	}
	إذا (ن > ٣٠) {
		اوقف
	}

	إذا (عدد_أولي(ن) و ليس (ن == ٢)) {
		اطبع(ن, "أوّلي فردي")
	} وإلا إذا (عدد_أولي(ن)) {
		اطبع(ن, "أوّلي زوجي (٢ فقط)")
	} وإلا إذا (ن % ٢ == ٠ أو ن % ٥ == ٠) {
		اطبع(ن, "مركّب يقبل القسمة على ٢ أو ٥")
	} وإلا {
		اطبع(ن, "مركّب آخر")
	}
}