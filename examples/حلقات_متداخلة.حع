# جدول مصنّف: حلقتان متداخلتان مع تفريع ثلاثي
لكل ص من ١ إلى ٣ {
	اطبع("الصف", ص)
	لكل ع من ١ إلى ٣ {
		حاصل = ص * ع

		إذا (حاصل % ٢ == ٠) {
			اطبع("  ", ص, "×", ع, "=", حاصل, "→ زوجي")
		} وإلا إذا (حاصل > ٥) {
			اطبع("  ", ص, "×", ع, "=", حاصل, "→ فردي كبير")
		} وإلا {
			اطبع("  ", ص, "×", ع, "=", حاصل, "→ فردي صغير")
		}
	}
}