# معادلة_تربيعية.حع — حل معادلة أس^٢ + بس + ج = ٠ رمزيًا ثم رسمها

رمز س

# المعاملات: س^٢ - ٥س + ٦ = ٠
أ = ١
ب = -٥
ج = ٦

معادلة = أ * س^٢ + ب * س + ج
اطبع("المعادلة:", معادلة)

الحلول = حلّ(معادلة, س)
اطبع("الجذور:", الحلول)

# رسم القطع المكافئ
ارسم(معادلة, س, -١, ٦, عنوان="القطع المكافئ")
اطبع("✅ انظر نافذة الرسم لرؤية القطع المكافئ")
