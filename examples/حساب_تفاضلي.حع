# حساب_تفاضلي.حع — اشتقاق وتكامل ورسم دالة مع مشتقتها

رمز س

د = س^٣ - ٢ * س + ١
اطبع("الدالة:", د)

المشتقة = اشتق(د, س)
اطبع("المشتقة الأولى:", المشتقة)

المشتقة_الثانية = اشتق(د, س, ٢)
اطبع("المشتقة الثانية:", المشتقة_الثانية)

# تكامل محدد من ٠ إلى ٢
التكامل = كامل(د, س, ٠, ٢)
اطبع("التكامل المحدد من ٠ إلى ٢:", التكامل)

# رسم الدالة ومشتقتها معًا
ارسم([د, المشتقة], س, -٣, ٣, عنوان="الدالة ومشتقتها")
اطبع("✅ انظر نافذة الرسم لرؤية الدالة ومشتقتها")
