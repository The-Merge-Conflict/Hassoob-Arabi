# مرحبا.حع — البرنامج الأول: ترحيب وحسابات أساسية

اطبع("مرحبًا بالعالم من حاسوب عربي!")

# حسابات عددية بسيطة
أ = ٣ + ٤
ب = ١٠ * ٢
ج = ٢ ^ ١٠

اطّبع("٣ + ٤ =", أ)
اطبع("١٠ × ٢ =", ب)
اطبع("٢ أس ١٠ =", ج)

# سلاسل نصية ودوال مدمجة
اسِم = "حاسوب"
اطبع("طول الاسم:", طول(اسم))
