# مصفوفات.حع — مصفوفتان ٣×٣، ضربهما بـ ** ثم المحدد والقيم الذاتية

أ = [[١, ٢, ٣], [٤, ٥, ٦], [٧, ٨, ١٠]]
ب = [[١, ٠, ٠], [٠, ١, ٠], [٠, ٠, ١]]

اطبع("المصفوفة أ:")
اطبع(أ)

# ضرب المصفوفات بالعامل **
ج = أ ** ب
اطبع("أ × ب =")
اطبع(ج)

# المحدد
اطبع("محدد أ:", محدد(أ))

# القيم الذاتية
اطبع("القيم الذاتية لـ أ:", قيم_ذاتية(أ))

# المنقول
اطبع("منقول أ:")
اطبع(نقل(أ))
